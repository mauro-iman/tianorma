# Supabase (Project Settings > API). La service key NUNCA va al navegador ni al repo.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Slug de la página real de Norma (la que se ve en "/")
NORMA_SLUG=norma

# WhatsApp (ver docs/SETUP-META.md). Se usan en la etapa del bot.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Números (con código de país, separados por coma) que pueden editar la página real de Norma.
NORMA_TELEFONOS=5491100000000

# Groq (transcripción de audios): https://console.groq.com/keys
GROQ_API_KEY=

# URL pública del sitio (si no, se usa el dominio de producción de Vercel).
PUBLIC_URL=
